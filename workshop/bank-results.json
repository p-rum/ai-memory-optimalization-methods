      "id": "fn:api.get_trader_dashboard",
      "text": "def get_trader_dashboard():\n    version = deployed_mechanism()\n    return {'client': 'DEMO-001', 'health': calculate_financial_health(version['weights']), 'version': version['id']}",
      "kind": "code",
      "label": "get_trader_dashboard",
      "source": "bank_demo/api.py:5-7",
      "module": "api"
    },
    {
      "id": "fn:health.calculate_liquidity_component",
      "text": "def calculate_liquidity_component(cash, outflows):\n    if outflows <= 0:\n        raise ValueError('outflows must be positive')\n    return max(0.0, min(1.0, cash / outflows / 2.0))",
      "kind": "code",
      "label": "calculate_liquidity_component",
      "source": "bank_demo/health.py:4-7",
      "module": "health"
    },
    {
      "id": "fn:health.calculate_margin_buffer",
      "text": "def calculate_margin_buffer(equity, initial_margin):\n    if equity <= 0:\n        raise ValueError('equity must be positive')\n    return max(0.0, min(1.0, ((equity - initial_margin) / equity) / 0.5))",
      "kind": "code",
      "label": "calculate_margin_buffer",
      "source": "bank_demo/health.py:9-12",
      "module": "health"
    },
    {
      "id": "fn:health.calculate_diversification",
      "text": "def calculate_diversification(largest_position_share):\n    if not 0.0 <= largest_position_share <= 1.0:\n        raise ValueError('share must be between 0 and 1')\n    return 1.0 - largest_position_share",
      "kind": "code",
      "label": "calculate_diversification",
      "source": "bank_demo/health.py:14-17",
      "module": "health"
    },
    {
      "id": "fn:health.calculate_financial_health",
      "text": "def calculate_financial_health(weights):\n    cashflows = load_cashflows()\n    margins = load_margin_snapshot()\n    position = load_positions()\n    liquidity = calculate_liquidity_component(cashflows['available_cash'], cashflows['next_week_outflows'])\n    margin = calculate_margin_buffer(margins['equity'], margins['initial_margin'])\n    diversification = calculate_diversification(position['largest_position_share'])\n    score = 100.0 * (weights['liquidity'] * liquidity + weights['margin'] * margin + weights['diversification'] * diversification)\n    return {'score': round(score, 2), 'components': {'liquidity': liquidity, 'margin': margin, 'diversification': diversification}}",
      "kind": "code",
      "label": "calculate_financial_health",
      "source": "bank_demo/health.py:19-27",
      "module": "health"
    },
    {
      "id": "fn:pnl.calculate_weekly_pnl",
      "text": "def calculate_weekly_pnl():\n    position = load_positions()\n    prices = load_closing_prices()[position['symbol']]\n    fx = load_fx_rates()['USD_EUR']\n    return round(position['quantity'] * (prices['week_end'] - prices['week_start']) * fx, 2)",
      "kind": "code",
      "label": "calculate_weekly_pnl",
      "source": "bank_demo/pnl.py:4-8",
      "module": "pnl"
    },
    {
      "id": "fn:registry.deployed_mechanism",
      "text": "def deployed_mechanism(as_of='2026-10-13'):\n    versions = json.loads(Path(__file__).with_name('mechanisms.json').read_text())\n    matches = [v for v in versions if v['status'] == 'deployed' and v['valid_from'] <= as_of and (v['valid_to'] is None or as_of < v['valid_to'])]\n    if len(matches) != 1:\n        raise ValueError('no unique deployed version')\n    return matches[0]",
      "kind": "code",
      "label": "deployed_mechanism",
      "source": "bank_demo/registry.py:5-10",
      "module": "registry"
    },
    {
      "id": "fn:report.generate_weekly_report",
      "text": "def generate_weekly_report():\n    profile = load_client_profile()\n    mechanism = deployed_mechanism()\n    return {'client': profile['client_id'], 'currency': profile['report_currency'], 'weekly_pnl': calculate_weekly_pnl(), 'financial_health': calculate_financial_health(mechanism['weights']), 'mechanism_version': mechanism['id']}",
      "kind": "code",
      "label": "generate_weekly_report",
      "source": "bank_demo/report.py:7-10",
      "module": "report"
    },
